# Database Configuration
MYSQL_DATABASE=restaurant_db
MYSQL_USER=restaurant_user
MYSQL_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_24_CHARACTERS
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_UNIQUE_PASSWORD_AT_LEAST_24_CHARACTERS

# Port Configuration
FRONTEND_PORT=3000

# Security (JWT)
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32

# VietQR Configuration (Tùy chọn)
BANK_BIN=970436
BANK_ACCOUNT_NUMBER=REPLACE_WITH_REAL_ACCOUNT_NUMBER
BANK_ACCOUNT_NAME=REPLACE_WITH_REAL_ACCOUNT_HOLDER_NAME
PROD_DATABASE_URL=jdbc:mysql://mysqldb:3306/restaurant_db?serverTimezone=UTC

# Production TLS and CORS (HTTPS domain must point to this server)
SITE_DOMAIN=restaurant.example.com
CADDY_EMAIL=admin@example.com
CORS_ALLOWED_ORIGINS=https://restaurant.example.com

# Set only for first production startup when creating the initial admin; remove afterward.
INITIAL_ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS
